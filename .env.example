# ========================================================
# TaskFlow Environment Variables (Vercel & Local Setup)
# ========================================================

# GEMINI_API_KEY: Required for tracking history and generating AI productivity reports.
# - On Vercel: Project Settings -> Environment Variables -> Add:
#     Key:   GEMINI_API_KEY
#     Value: <your-gemini-api-key>
# - On Local (.env):
#     GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Optional application URL
APP_URL="https://your-taskflow-app.vercel.app"
